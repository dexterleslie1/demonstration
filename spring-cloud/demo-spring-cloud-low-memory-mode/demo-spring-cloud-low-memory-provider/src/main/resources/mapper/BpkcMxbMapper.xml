<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.future.demo.provider.mapper.BpkcMxbMapper">
    <select id="selectAllIds" resultType="long">
        SELECT id
        FROM bpkc_mxb
        ORDER BY id
    </select>

    <!-- fetchSize=-2147483648（Integer.MIN_VALUE）启用 MySQL 流式结果集，避免一次加载全部行 -->
    <select id="streamFromId" resultType="com.future.demo.common.entity.BpkcMxb"
            fetchSize="-2147483648" resultSetType="FORWARD_ONLY">
        SELECT *
        FROM bpkc_mxb
        WHERE id &gt;= #{startId}
        ORDER BY id
        LIMIT #{limit}
    </select>
</mapper>
